# Mot de passe de l’espace membres (/espace-membres)
# Préféré :
MEMBERS_PASSWORD=
# Alias accepté si MEMBERS_PASSWORD est vide :
ESPACE_MEMBRES_PASSWORD=
#
# Vercel : Project → Settings → Environment Variables
# (Preview + Production), puis redéployer.

# Courriel des formulaires en ligne (Infomaniak SMTP)
# Valeurs typiques Infomaniak :
#   SMTP_HOST=mail.infomaniak.com
#   SMTP_PORT=587
#   SMTP_USER=info@policemunicipale.ch
#   SMTP_PASSWORD=<mot de passe de la boîte>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
